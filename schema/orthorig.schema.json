{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://crenet.games/schemas/orthorig.schema.json",
	"title": "OrthoRig 2D Skeletal Animation Schema",
	"description": "Formal contract between the OrthoRig Blender compiler and the @crenet/orthorig PixiJS v8 TypeScript runtime.",
	"type": "object",
	"required": ["meta", "bones", "slots", "ik_constraints", "animations"],
	"additionalProperties": false,
	"properties": {
		"meta": {
			"type": "object",
			"required": ["version", "sourceFile", "fps", "coordinateSystem"],
			"additionalProperties": false,
			"properties": {
				"version": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
				},
				"sourceFile": {
					"type": "string",
					"minLength": 1
				},
				"fps": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"coordinateSystem": {
					"type": "string",
					"const": "pixi-y-down"
				}
			}
		},
		"bones": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"name",
					"parent",
					"length",
					"restX",
					"restY",
					"restRotation",
					"zIndex"
				],
				"additionalProperties": false,
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"parent": { "type": ["string", "null"] },
					"length": { "type": "number", "minimum": 0 },
					"restX": { "type": "number" },
					"restY": { "type": "number" },
					"restRotation": { "type": "number" },
					"zIndex": { "type": "integer" }
				}
			}
		},
		"slots": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"bone",
					"shapeType",
					"width",
					"height",
					"colorHex",
					"offsetX",
					"offsetY",
					"zIndex"
				],
				"additionalProperties": false,
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"bone": { "type": "string", "minLength": 1 },
					"shapeType": {
						"type": "string",
						"enum": ["rect", "polygon", "sprite"]
					},
					"width": { "type": "number", "minimum": 0 },
					"height": { "type": "number", "minimum": 0 },
					"colorHex": {
						"type": "string",
						"pattern": "^#[0-9A-Fa-f]{6}$"
					},
					"strokeColorHex": {
						"type": "string",
						"pattern": "^#[0-9A-Fa-f]{6}$"
					},
					"offsetX": { "type": "number" },
					"offsetY": { "type": "number" },
					"rotation": { "type": "number" },
					"zIndex": { "type": "integer" },
					"points": {
						"type": "array",
						"items": { "type": "number" }
					},
					"atlasRegion": {
						"type": "object",
						"required": ["x", "y", "width", "height"],
						"additionalProperties": false,
						"properties": {
							"texture": { "type": "string" },
							"x": { "type": "number", "minimum": 0 },
							"y": { "type": "number", "minimum": 0 },
							"width": { "type": "number", "exclusiveMinimum": 0 },
							"height": { "type": "number", "exclusiveMinimum": 0 }
						}
					}
				}
			}
		},
		"ik_constraints": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "chain", "target", "bendDirection"],
				"additionalProperties": false,
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"chain": {
						"type": "array",
						"prefixItems": [
							{ "type": "string", "minLength": 1 },
							{ "type": "string", "minLength": 1 }
						],
						"minItems": 2,
						"maxItems": 2
					},
					"target": { "type": "string", "minLength": 1 },
					"bendDirection": {
						"type": "integer",
						"enum": [1, -1]
					}
				}
			}
		},
		"animations": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"required": ["duration", "loop", "tracks"],
				"additionalProperties": false,
				"properties": {
					"duration": { "type": "number", "minimum": 0 },
					"loop": { "type": "boolean" },
					"tracks": {
						"type": "object",
						"additionalProperties": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "object",
								"required": ["time", "x", "y", "rotation"],
								"additionalProperties": false,
								"properties": {
									"time": { "type": "number", "minimum": 0 },
									"x": { "type": "number" },
									"y": { "type": "number" },
									"rotation": { "type": "number" },
									"easing": {
										"type": "string",
										"enum": ["linear", "cubic-bezier"]
									},
									"bezier": {
										"type": "array",
										"minItems": 4,
										"maxItems": 4,
										"items": { "type": "number" }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
